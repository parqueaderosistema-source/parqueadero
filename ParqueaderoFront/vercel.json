{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/parqueadero-front/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://URL-DEL-BACKEND/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
