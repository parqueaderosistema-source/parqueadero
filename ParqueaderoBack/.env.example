# development | production. En Render: production
NODE_ENV=development
# Render asigna el puerto solo; en local 3000
PORT=3000
# Origen del front permitido por CORS, sin "/" final.
# Local: http://localhost:4200 · Producción: https://parqueadero-pi.vercel.app
FRONTEND_URL=http://localhost:4200
MONGODB_URI=
# Opcional: DNS para resolver mongodb+srv en redes con problemas (separados por coma)
MONGODB_DNS_SERVERS=
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
APP_TIMEZONE=America/Bogota
# Número de proxies delante del back (nginx, Render). Si se omite: 1 en producción, 0 en desarrollo.
TRUST_PROXY=0
# Solo para los scripts seed:usuarios y reset:passwords
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRABAJADOR_EMAIL=
TRABAJADOR_PASSWORD=
