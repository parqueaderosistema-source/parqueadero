NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
MONGODB_URI=
# Opcional: DNS para resolver mongodb+srv en redes con problemas (separados por coma)
MONGODB_DNS_SERVERS=
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
APP_TIMEZONE=America/Bogota
# Número de proxies delante del back (nginx, balanceador). 0 si no hay.
TRUST_PROXY=0
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRABAJADOR_EMAIL=
TRABAJADOR_PASSWORD=
